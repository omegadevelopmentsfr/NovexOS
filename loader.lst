  78              	
  79              	    /* 4b. Detect extended memory (KB above 1 MB) via INT 15h / AH=88h.
  80              	     *     This gives the PMM enough free pages so kmalloc works after boot.
  81              	     *     QEMU with -m 512M returns 65535 (the AH=88h cap); that is >60 MB
  82              	     *     of usable pages once the kernel is subtracted — plenty for NovexDE.
  83              	     *     Interrupts must be enabled (sti already done above). */
  84 007b B488     	    mov $0x88, %ah
  85 007d CD15     	    int $0x15
  86 007f 7212     	    jc .s2_mem_fallback    /* CF set = not supported */
  87 0081 09C0     	    or %ax, %ax
  88 0083 740E     	    jz .s2_mem_fallback    /* AX=0 is useless */
  89 0085 66C7065D 	    movl $0, (mem_upper_kb)   /* zero high 16 bits first */
  89      02000000 
  89      00
  90 008e A35D02   	    movw %ax, (mem_upper_kb)  /* store KB above 1 MB */
  91 0091 EB09     	    jmp .s2_mem_done
  92              	.s2_mem_fallback:
  93 0093 66C7065D 	    movl $15360, (mem_upper_kb) /* safe default: 15 MB above 1 MB */
