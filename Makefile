# ============================================================
# NovexOS - Makefile
# ============================================================

# --- Détection de l'OS ---
# Windows_NT est une variable d'environnement toujours définie nativement
# sous Windows (cmd, PowerShell). Absente sous Linux/macOS.
ifeq ($(OS),Windows_NT)
    HOST_OS := Windows
else
    HOST_OS := $(shell uname -s)
endif

# --- Toolchain ---
# Sous Windows, il n'existe AUCUN fallback valide sans cross-compiler
# (l'hôte ne sait produire que du PE, jamais de l'ELF) : on force donc
# directement x86_64-elf-gcc, sans détection préalable. Si jamais il est
# absent du PATH, l'erreur apparaîtra naturellement à l'appel — plus fiable
# qu'une détection maison qui peut se tromper selon le shell utilisé par Make.
#
# Sous Linux/macOS, x86_64-elf-gcc reste optionnel : fallback sur le GCC
# système s'il n'est pas trouvé.
ifeq ($(HOST_OS),Windows)
    IS_CROSS := yes
    PYTHON   := python
else
    IS_CROSS := $(shell command -v x86_64-elf-gcc 2>/dev/null && echo yes || echo no)
    PYTHON   := python3
endif

# Forçage manuel si besoin (ex: `make CROSS=no build` pour désactiver
# explicitement sous Linux/macOS).
ifdef CROSS
    IS_CROSS := $(CROSS)
endif

ifeq ($(IS_CROSS),yes)
    CC      := x86_64-elf-gcc
    AS      := x86_64-elf-gcc   # route through gcc for the C preprocessor
    LD      := x86_64-elf-ld
    OBJCOPY := x86_64-elf-objcopy
    AS32    := x86_64-elf-as    # used for the 16/32-bit real-mode loader
    LD32    := x86_64-elf-ld
    CFLAGS  := -std=gnu99 -ffreestanding -O2 -Wall -Wextra -Werror -Isrc \
               -fno-pic -fno-pie -fno-stack-protector -fno-stack-check \
               -mcmodel=large -mno-red-zone -mno-mmx -mno-sse -mno-sse2
else
    CC      := gcc
    AS      := gcc              # route through gcc for the C preprocessor
    LD      := ld
    OBJCOPY := objcopy
    AS32    := as
    LD32    := ld
    CFLAGS  := -std=gnu99 -ffreestanding -O2 -Wall -Wextra -Werror -Isrc \
               -fno-pic -fno-pie -fno-stack-protector -fno-stack-check \
               -m64 -mcmodel=large -mno-red-zone -mno-mmx -mno-sse -mno-sse2
endif

LDFLAGS := -T linker.ld -melf_x86_64 -n -no-pie
ASFLAGS := -x assembler-with-cpp -c -m64

# --- Helpers portables (mkdir/rm/etc. diffèrent entre cmd.exe et sh) ---
ifeq ($(HOST_OS),Windows)
    MKDIR_P  = if not exist "$(1)" mkdir "$(1)"
    RMDIR_F  = if exist "$(1)" rmdir /s /q "$(1)"
    RMFILE_F = if exist "$(1)" del /q "$(1)"
    TOUCH    = type nul > "$(1)"
else
    MKDIR_P  = mkdir -p $(1)
    RMDIR_F  = rm -rf $(1)
    RMFILE_F = rm -f $(1)
    TOUCH    = touch $(1)
endif

# --- Source directories and files ---
SRCDIR := src
OBJDIR := build

# Kernel assembly files (routed through gcc for #define support)
ASM_SRC := $(SRCDIR)/boot.s $(SRCDIR)/interrupts.s
C_SRC   := $(wildcard $(SRCDIR)/*.c)

ASM_OBJ := $(OBJDIR)/boot.o $(OBJDIR)/interrupts.o
C_OBJ   := $(patsubst $(SRCDIR)/%.c,$(OBJDIR)/%.o,$(C_SRC))

# loader_bin.o is generated by objcopy from the 16-bit loader binary
LOADER_OBJ := $(OBJDIR)/loader_bin.o

OBJECTS := $(ASM_OBJ) $(C_OBJ) $(LOADER_OBJ)

# --- Output files ---
KERNEL   := novexos.bin
ISO      := novexos.iso
DISK_IMG := disk.img

# ============================================================
# PNG assets -> C headers (requires Python 3 + Pillow)
# Run 'make assets' after adding or modifying any PNG in src/assets/.
# The generated *_img.h files are committed to the repo so that a plain
# 'make' works even without Python/Pillow installed.
#
#   Cursors    : 16x16   (src/assets/mouse_pointer/*.png)
#   Background : 1024x768 (src/assets/background.png)
# ============================================================
ASSETS_SCRIPT := tools/png_to_header.py

# Cursor headers (16x16)
CURSOR_PNGS    := $(SRCDIR)/assets/mouse_pointer/pointer.png
CURSOR_HEADERS := $(SRCDIR)/assets/mouse_pointer/pointer_img.h

# Background header (1024x768)
BG_PNG    := $(SRCDIR)/assets/background.png
BG_HEADER := $(SRCDIR)/assets/background_img.h

ASSET_HEADERS := $(CURSOR_HEADERS) $(BG_HEADER)

assets: $(ASSET_HEADERS)
	@echo ""
	@echo "========================================="
	@echo " Assets regenerated ($(words $(ASSET_HEADERS)) headers)"
	@echo "========================================="

# Cursor sprites — 16x16
$(SRCDIR)/assets/mouse_pointer/%_img.h: $(SRCDIR)/assets/mouse_pointer/%.png $(ASSETS_SCRIPT)
	$(PYTHON) $(ASSETS_SCRIPT) $< $@ 16 16

# Background — 1024x768 (matches default VBE resolution -> zero-cost blit)
$(BG_HEADER): $(BG_PNG) $(ASSETS_SCRIPT)
	$(PYTHON) $(ASSETS_SCRIPT) $< $@ 1024 768

# assets.o depends on all generated headers
$(OBJDIR)/assets.o: $(ASSET_HEADERS)

# ============================================================
# Default target
# ============================================================
all: $(KERNEL)
	@echo ""
	@echo "========================================="
	@echo " NovexOS compiled : $(KERNEL)"
	@echo " Launch with : make run"
	@echo "========================================="

# ============================================================
# Main kernel linking
# ============================================================
$(KERNEL): $(OBJECTS)
	$(LD) $(LDFLAGS) -o $@ $^

# ============================================================
# Assemble kernel .s files (via gcc for #define support)
# ============================================================
$(OBJDIR)/boot.o: $(SRCDIR)/boot.s | $(OBJDIR)/.created
	$(AS) $(ASFLAGS) $< -o $@

$(OBJDIR)/interrupts.o: $(SRCDIR)/interrupts.s | $(OBJDIR)/.created
	$(AS) $(ASFLAGS) $< -o $@

# ============================================================
# Compile .c files
# ============================================================
$(OBJDIR)/%.o: $(SRCDIR)/%.c | $(OBJDIR)/.created
	$(CC) -c $< -o $@ $(CFLAGS)

# ============================================================
# Build the 16-bit loader (real mode -> flat binary)
#
#   1. Assemble loader.s into ELF with as (16-bit, no CPP)
#   2. Link into a flat binary starting at 0x0
#   3. Convert the .bin into .o (symbols _binary_..._start/end/size)
#
# NB: utilise AS32/LD32 (le binutils du cross-compiler sous Windows,
# car l'hôte ne sait pas produire d'ELF ; le binutils système sous Linux).
# ============================================================
$(OBJDIR)/loader.o: $(SRCDIR)/loader.s | $(OBJDIR)/.created
	$(AS32) --32 $< -o $@

$(OBJDIR)/loader.elf: $(OBJDIR)/loader.o
	$(LD32) -m elf_i386 -Ttext=0x0 $< -o $@

$(OBJDIR)/loader.bin: $(OBJDIR)/loader.elf
	$(OBJCOPY) -O binary $< $@

# objcopy embed: generates the symbols referenced by shell.c:
#   _binary_build_loader_bin_start
#   _binary_build_loader_bin_end
#   _binary_build_loader_bin_size
$(OBJDIR)/loader_bin.o: $(OBJDIR)/loader.bin
	$(OBJCOPY) \
		-I binary \
		-O elf64-x86-64 \
		-B i386:x86-64 \
		--rename-section .data=.rodata,alloc,load,readonly,data,contents \
		$< $@

# ============================================================
# Create the build directory (sentinel to avoid name conflict
# with the phony target "build")
# ============================================================
$(OBJDIR)/.created:
	$(call MKDIR_P,$(OBJDIR))
	@$(call TOUCH,$@)

# ============================================================
# Create empty disk image (200 MB)
# ============================================================
ifeq ($(HOST_OS),Windows)
$(DISK_IMG):
	fsutil file createnew $@ 209715200
else
$(DISK_IMG):
	dd if=/dev/zero of=$@ bs=1M count=200
endif

# ============================================================
# make run / make build / ISO creation
#
# Sous Linux/macOS : chemin inchangé (ISO GRUB hybride + disque + QEMU).
#
# Sous Windows : grub-mkrescue n'a pas d'équivalent natif fiable, donc pas
# de veritable ISO bootable. On compile le kernel et on le boote directement
# dans QEMU via -kernel (le binaire est multiboot-compliant), sans ISO ni
# image disque.
# ============================================================
ifeq ($(HOST_OS),Windows)

run: $(ISO) $(DISK_IMG)
	@echo ""
	@echo ">>> Launching NovexOS in QEMU (ISO via GRUB + 200MB disk)..."
	@echo ">>> (Quit: close the window or Ctrl+C in the terminal)"
	@echo ""
	qemu-system-x86_64 \
		-drive file=$(ISO),format=raw,index=1,media=cdrom \
		-drive file=$(DISK_IMG),format=raw,index=0,media=disk \
		-boot d \
		-m 512M \
		-device VGA,vgamem_mb=16 \
		-serial stdio \
		-name "NovexOS"

run-disk: $(DISK_IMG)
	@echo ""
	@echo ">>> Launching NovexOS in QEMU (Booting directly from disk.img)..."
	@echo ">>> (Quit: close the window or Ctrl+C in the terminal)"
	@echo ""
	qemu-system-x86_64 \
		-drive file=$(DISK_IMG),format=raw,index=0,media=disk \
		-boot c \
		-m 512M \
		-device VGA,vgamem_mb=16 \
		-serial stdio \
		-name "NovexOS (Disk Boot)"

build: assets $(KERNEL)
	@echo ""
	@echo "========================================="
	@echo " Build complete (Windows) : $(KERNEL)"
	@echo " Note: no bootable ISO from this target"
	@echo " (grub-mkrescue is unavailable natively)."
	@echo " Run : make iso   (requires WSL, see installer)"
	@echo " Launch with : make run"
	@echo "========================================="

# ============================================================
# make iso (Windows only) — real bootable ISO via WSL
#
# grub-mkrescue has no native Windows build, but WSL gives us a real
# Linux grub-mkrescue/xorriso. Everything that's plain filesystem work
# (mkdir, copy, writing grub.cfg) stays on the Windows side to avoid
# fragile quoting across cmd.exe -> wsl.exe -> bash; only grub-mkrescue
# itself runs inside WSL, on the same files via the /mnt/c/... bind mount.
#
# Prerequisite (one-time): WSL installed + xorriso/grub-common/grub-pc-bin
# /mtools installed inside it — use the dependencies installer's
# "WSL - outils ISO" option, or manually:
#   wsl --install -d Debian
#   wsl -u root apt-get update
#   wsl -u root apt-get install -y xorriso grub-common grub-pc-bin mtools
# ============================================================
iso: $(KERNEL)
	@echo ""
	@echo ">>> Generating ISO via WSL (grub-mkrescue)..."
	@if not exist isodir\boot\grub mkdir isodir\boot\grub
	@copy /Y "$(KERNEL)" "isodir\boot\novexos.bin" >NUL
	@echo set timeout=3 > isodir\boot\grub\grub.cfg
	@echo set default=0 >> isodir\boot\grub\grub.cfg
	@echo. >> isodir\boot\grub\grub.cfg
	@echo menuentry "NovexOS" { >> isodir\boot\grub\grub.cfg
	@echo     multiboot /boot/novexos.bin >> isodir\boot\grub\grub.cfg
	@echo     boot >> isodir\boot\grub\grub.cfg
	@echo } >> isodir\boot\grub\grub.cfg
	wsl -u root grub-mkrescue -o $(ISO) isodir
	@if exist isodir rmdir /s /q isodir
	@echo ""
	@echo "========================================="
	@echo " ISO created (via WSL) : $(ISO)"
	@echo "========================================="

else

# ============================================================
# Create bootable ISO (requires grub-mkrescue + xorriso)
# grub-mkrescue generates a hybrid MBR ISO -> flashable to USB
# ============================================================
$(ISO): $(KERNEL)
	@mkdir -p isodir/boot/grub
	@cp $(KERNEL) isodir/boot/novexos.bin
	@printf 'set timeout=3\nset default=0\n\nmenuentry "NovexOS" {\n    multiboot /boot/novexos.bin\n    boot\n}\n' \
		> isodir/boot/grub/grub.cfg
	grub-mkrescue -o $(ISO) isodir 2>/dev/null
	@rm -rf isodir
	@echo ""
	@echo "========================================="
	@echo " ISO created : $(ISO)"
	@echo " Flash to USB:"
	@echo "   sudo dd if=$(ISO) of=/dev/sdX bs=4M status=progress"
	@echo "========================================="

run: assets $(ISO) $(DISK_IMG)
	@echo ""
	@echo ">>> Launching NovexOS in QEMU..."
	@echo ">>> (Quit: close the window or Ctrl+C in the terminal)"
	@echo ""
	qemu-system-x86_64 \
		-drive file=$(ISO),format=raw,index=1,media=cdrom \
		-drive file=$(DISK_IMG),format=raw,index=0,media=disk \
		-boot d \
		-m 512M \
		-device VGA,vgamem_mb=16 \
		-serial stdio \
		-name "NovexOS"

run-disk: $(DISK_IMG)
	@echo ""
	@echo ">>> Launching NovexOS in QEMU (Booting directly from disk.img)..."
	@echo ">>> (Quit: close the window or Ctrl+C in the terminal)"
	@echo ""
	qemu-system-x86_64 \
		-drive file=$(DISK_IMG),format=raw,index=0,media=disk \
		-boot c \
		-m 512M \
		-device VGA,vgamem_mb=16 \
		-serial stdio \
		-name "NovexOS (Disk Boot)"

build: assets $(ISO)
	@echo ""
	@echo "========================================="
	@echo " Build complete : $(ISO)"
	@echo " Launch with : make run"
	@echo "========================================="

endif

# ============================================================
# make clean — Delete all generated files
# ============================================================
clean:
	@$(call RMDIR_F,$(OBJDIR))
	@$(call RMFILE_F,$(KERNEL))
	@$(call RMFILE_F,$(ISO))
	@$(call RMFILE_F,$(DISK_IMG))
	@$(call RMDIR_F,isodir)
	@echo "Clean complete."

.PHONY: all build clean run run-disk assets iso